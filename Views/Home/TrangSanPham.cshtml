@model TheLoai
@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />

@* // Icon *@
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet" />

<div class="product-detail">
    <nav class="breadcrumb">
        <a href="#" class="breadcrumb__back" id="backButton">
            <span class="breadcrumb__icon">
                <i class="ri-arrow-left-line"></i>
            </span>
            <span class="breadcrumb__text">Trở lại</span>
        </a>
        <span class="breadcrumb__divider">/</span>
        <a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a>
    </nav>
    @if (Model != null && Model.SanPhams != null && Model.SanPhams.Any())
    {
        var sp = Model.SanPhams.First();

        <div class="product-detail__container">
            <!-- Cột ảnh -->
            @{int chon = sp.MaTheLoai;}
            
                <div class="product-detail__image">
                    @switch (chon)
                    {
                        case 1:
                            <img src="~/img/Giay/Samba/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"/>
                            break;
                        case 2:
                            <img src="~/img/Giay/Gazelle/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham" />
                            break;
                        case 3:
                            <img src="~/img/Giay/Adizero/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"  />
                            break;
                        case 4:
                            <img src="~/img/Giay/Superstar/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"  />
                            break;
                        case 5 or 6 or 7:
                            <img src="~/img/Giay/The_Thao/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"  />
                            break;
                        case 8:
                            <img src="~/img/Dep/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"  />
                            break;
                        case 9:
                            <img src="~/img/Ao/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham"  />
                            break;
                        case 13:
                            <img src="~/img/Quan/@(sp.HinhAnh ?? "default.jpg")" class="product-detail__image-img" alt="@sp.TenSanPham" />
                            break;
                    }
                </div>

            <!-- Cột thông tin -->
            <div class="product-detail__info">
                <h2 class="product-detail__name">@(sp.TenSanPham ?? "Không có tên")</h2>
                <p class="product-detail__category">Originals</p>
                <p class="product-detail__price">@sp.Gia.ToString("N0") VND</p>
                <p class="product-detail__code">Mã sản phẩm: @sp.MaSanPham</p>

                <!-- Kích thước -->
                <div class="product-detail__size-header">
                    <span class="product-detail__size-title">Kích cỡ:</span>
                    <a href="#" class="product-detail__size-guide">Hướng dẫn chọn kích cỡ</a>
                </div>

                <div class="size-guide-popup" id="sizeGuidePopup">
                    <span class="close-btn" onclick="closePopup()">×</span>
                    <h3>Hướng Dẫn Chọn Kích Cỡ</h3>
                    @if (chon == 9) // Áo
                    {
                        <p>Vui lòng đo số đo cơ thể (ngực, eo, chiều dài áo, chiều dài tay áo) và tham khảo bảng dưới đây:</p>
                        <table class="size-guide-table">
                            <thead>
                                <tr>
                                    <th>Kích cỡ</th>
                                    <th>Ngực (cm)</th>
                                    <th>Eo (cm)</th>
                                    <th>Chiều dài áo (cm)</th>
                                    <th>Chiều dài tay áo (cm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>XS</td><td>80-84</td><td>60-64</td><td>60-62</td><td>58-60</td></tr>
                                <tr><td>S</td><td>85-89</td><td>65-69</td><td>62-64</td><td>60-62</td></tr>
                                <tr><td>M</td><td>90-94</td><td>70-74</td><td>64-66</td><td>62-64</td></tr>
                                <tr><td>L</td><td>95-99</td><td>75-79</td><td>66-68</td><td>64-66</td></tr>
                                <tr><td>XL</td><td>100-104</td><td>80-84</td><td>68-70</td><td>66-68</td></tr>
                                <tr><td>XXL</td><td>105-109</td><td>85-89</td><td>70-72</td><td>68-70</td></tr>
                            </tbody>
                        </table>
                        <p>Lưu ý: Chọn kích cỡ lớn hơn nếu bạn muốn mặc rộng rãi.</p>
                    }
                    else if (chon == 13) // Quần
                    {
                        <p>Vui lòng đo số đo cơ thể (eo, hông, độ dài quần, chiều rộng ống quần) và tham khảo bảng dưới đây:</p>
                        <table class="size-guide-table">
                            <thead>
                                <tr>
                                    <th>Kích cỡ</th>
                                    <th>Vòng eo<br>(cm)</th>
                                    <th>Vòng hông<br>(cm)</th>
                                    <th>Độ dài quần<br>(cm)</th>
                                    <th>Chiều rộng ống quần<br>(cm)</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr><td>XS</td><td>60-64</td><td>84-88</td><td>98-100</td><td>15-17</td></tr>
                                <tr><td>S</td><td>65-69</td><td>89-93</td><td>100-102</td><td>17-19</td></tr>
                                <tr><td>M</td><td>70-74</td><td>94-98</td><td>102-104</td><td>19-21</td></tr>
                                <tr><td>L</td><td>75-79</td><td>99-103</td><td>104-106</td><td>21-23</td></tr>
                                <tr><td>XL</td><td>80-84</td><td>104-108</td><td>106-108</td><td>23-25</td></tr>
                                <tr><td>XXL</td><td>85-89</td><td>109-113</td><td>108-110</td><td>25-27</td></tr>
                            </tbody>
                        </table>
                        <p>Lưu ý: Chọn kích cỡ lớn hơn nếu bạn muốn mặc thoải mái hoặc có chân dài hơn.</p>
                    }
                    else // Giày dép
                    {
                        <p>Vui lòng đo chiều dài bàn chân và tham khảo bảng dưới đây:</p>
                        <table class="size-guide-table">
                            <thead>
                                <tr>
                                    <th>Kích cỡ UK</th>
                                    <th>Chiều dài (cm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>3.5</td><td>22.0</td></tr>
                                <tr><td>4</td><td>22.5</td></tr>
                                <tr><td>4.5</td><td>23.0</td></tr>
                                <tr><td>5</td><td>23.5</td></tr>
                                <tr><td>5.5</td><td>24.0</td></tr>
                                <tr><td>6</td><td>24.5</td></tr>
                                <tr><td>6.5</td><td>25.0</td></tr>
                                <tr><td>7</td><td>25.5</td></tr>
                                <tr><td>7.5</td><td>26.0</td></tr>
                                <tr><td>8</td><td>26.5</td></tr>
                                <tr><td>8.5</td><td>27.0</td></tr>
                                <tr><td>9</td><td>27.5</td></tr>
                                <tr><td>9.5</td><td>28.0</td></tr>
                                <tr><td>10</td><td>28.5</td></tr>
                            </tbody>
                        </table>
                        <p>Lưu ý: Chọn kích cỡ lớn hơn nếu bạn có bàn chân rộng.</p>
                    }
                </div>

                <div id="size-buttons" class="product-detail__sizes">
                    @foreach (var sanPham in Model.SanPhams)
                    {
                        <button type="button" class="size-btn @(sanPham.SoLuong == 0 ? "disabled" : "")"
                                data-id="@sanPham.MaSanPham"
                                data-max="@sanPham.SoLuong"
                                data-size="@sanPham.Size"
                        @(sanPham.SoLuong == 0 ? "disabled" : "")>
                            @(string.IsNullOrEmpty(sanPham.Size) ? "Không có kích thước" : sanPham.Size) UK
                        </button>
                    }
                </div>

                <!-- Số lượng -->
                <div class="product-detail__quantity">
                    <label for="soLuong">Số Lượng:</label>
                    <div class="quantity-controls">
                        <button type="button" class="quantity-btn" onclick="$('#soLuong').val(Math.max(1, parseInt($('#soLuong').val()) - 1))">-</button>
                        <input type="number" id="soLuong" class="form-control" min="1" value="1" />
                        <button type="button" class="quantity-btn" onclick="$('#soLuong').val(parseInt($('#soLuong').val()) + 1)">+</button>
                    </div>
                </div>

                <button type="button" class="btn btn-primary add-to-cart" disabled>Thêm Vào Giỏ Hàng</button>
            </div>
        </div>
    }
    else
    {
        <p>@(ViewBag.Message ?? "Không tìm thấy sản phẩm.")</p>
    }
</div>



@section Scripts {
    <script>
        $(document).ready(function () {
            let selectedSizeId = null;

            // Xử lý chọn kích thước
            $('#size-buttons .size-btn').click(function () {
                if ($(this).hasClass('disabled')) return; // Không cho chọn nếu hết hàng

                $('#size-buttons .size-btn').removeClass('selected');
                $(this).addClass('selected');
                selectedSizeId = $(this).data('id');
                var max = $(this).data('max');
                $('#soLuong').attr('max', max);
                if (parseInt($('#soLuong').val()) > max) {
                    $('#soLuong').val(max);
                }
                $('.add-to-cart').prop('disabled', false); // Kích hoạt nút thêm vào giỏ hàng
            });

            // Khởi tạo với kích thước đầu tiên có sẵn
            var firstAvailable = $('#size-buttons .size-btn:not(.disabled)').first();
            if (firstAvailable.length) {
                firstAvailable.click();
            }

            // Xử lý thêm vào giỏ hàng
            $('.add-to-cart').click(function () {
                if (!selectedSizeId) {
                    alert("Vui lòng chọn kích thước.");
                    return;
                }

                var soLuong = parseInt($('#soLuong').val());
                var maxSoLuong = parseInt($('#soLuong').attr('max'));
                var size = $('#size-buttons .size-btn.selected').data('size');

                if (isNaN(soLuong) || soLuong < 1) {
                    alert("Vui lòng nhập số lượng hợp lệ.");
                    return;
                }
                if (soLuong > maxSoLuong) {
                    alert("Số lượng vượt quá tồn kho cho kích thước " + size + " (" + maxSoLuong + ").");
                    $('#soLuong').val(maxSoLuong);
                    return;
                }

                // Vô hiệu hóa nút trong khi xử lý AJAX
                $(this).prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("AddItemToCart", "Cart")',
                    type: 'POST',
                    data: { spId: selectedSizeId, soLuong: soLuong },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            $.get('@Url.Action("GetCartItemCount", "Cart")', function (data) {
                                $('#cart-item-count').text(data.totalCartItems);
                            });
                        } else {
                            alert(response.message || "Có lỗi xảy ra khi thêm vào giỏ hàng.");
                        }
                        // Kích hoạt lại nút sau khi hoàn tất
                        $('.add-to-cart').prop('disabled', false);
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            alert("Bạn cần đăng nhập để thêm vào giỏ hàng.");
                            window.location.href = '/Identity/Account/Login';
                        } else {
                            alert("Có lỗi xảy ra khi thêm vào giỏ hàng.");
                        }
                        // Kích hoạt lại nút nếu có lỗi
                        $('.add-to-cart').prop('disabled', false);
                    }
                });
            });

            $('#backButton').click(function (e) {
                e.preventDefault(); // Ngăn chặn hành vi mặc định của thẻ <a>
                window.history.back(); // Quay lại trang trước đó
            });

             document.querySelector('.product-detail__size-guide').addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('sizeGuidePopup').classList.add('show');
        });

        function closePopup() {
            document.getElementById('sizeGuidePopup').classList.remove('show');
        }

        // Close popup when clicking outside
        window.addEventListener('click', function(e) {
            const popup = document.getElementById('sizeGuidePopup');
            if (e.target == popup) {
                popup.classList.remove('show');
            }
        });

         // Ensure close button works correctly
        document.querySelector('.close-btn').addEventListener('click', function(e) {
            e.stopPropagation(); // Ngăn chặn sự kiện lan ra ngoài
            closePopup();
        });
        });
    </script>
}