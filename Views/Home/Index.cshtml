@model TheLoai

@{
    ViewData["Title"] = "adidas Vietnam Online";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <form>
        <div class="col-12">
            @* <label> *@
            @*     Bộ sưu tập  *@
            @* </label> *@
            <select class="form-select" aria-label="Default select example">
                <option selected>Bộ sưu tập</option>
                <option value="1">Giày Samba</option>
                <option value="2">Giày Gazelle</option>
                <option value="3">Giày Spezial</option>
                <option value="4">Giày Superstar</option>
                <option value="5">Dép </option>
                <option value="6">Quần áo</option>
            </select>
        </div>

    </form>

</div>
@* Lấy thông tin của 1 loại sản phẩm *@
<div>


    @if (Model != null && Model.SanPhams != null)
    {
        string anh = "";
        @foreach (var sp in Model.SanPhams)
        {
            @if (anh.CompareTo(sp.HinhAnh)!=0)
            {
            

                <div class="card" style="width: 18rem;">
                   <a class="header__link" asp-controller="Home" asp-action="TrangSanPham">
                       <img src="~/img/Giay/Bo_suu_tap/Samba/Jane/Better Scarlet  Team Victory Red  Gum/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="Samba">
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">@(sp.TenSanPham ?? "Không có tên")</h5>
                        <p class="card-text">@(sp.Gia)</p>
                        <button type="button" class="btn btn-primary add-to-cart-btn" data-spid="@sp.MaSanPham">Thêm vào giỏ hàng</button>
                        </div>
                </div>
           
                anh = sp.HinhAnh;
            }
            
        }
    }
    else
    {
        <p>Không có sản phẩm để hiển thị.</p>
    }
    
</div>
@section Scripts {
    <script>
            $(document).ready(function () {
                $('.add-to-cart-btn').click(function () {
                    var spId = $(this).data('spid');
                    $.ajax({
                        url: '@Url.Action("AddItemToCart", "Cart")', // Gọi CartController
                        type: 'POST',
                        data: { spId: spId, soLuong: 1 },
                        success: function (response) {
                            if (response.success) {
                                alert(response.message);
                                // Có thể cập nhật số lượng giỏ hàng ở đây nếu muốn
                            } else {
                                alert(response.message || "Có lỗi xảy ra.");
                            }
                        },
                        error: function (xhr) {
                            if (xhr.status === 401) {
                                alert("Bạn cần đăng nhập để thêm vào giỏ hàng.");
                                window.location.href = '/Account/Login';
                            } else {
                                alert("Có lỗi xảy ra khi thêm vào giỏ hàng.");
                            }
                        }
                    });
                });
        });
    </script>
}


