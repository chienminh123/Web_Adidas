@model TheLoai

@{
    ViewData["Title"] = "adidas Vietnam Online";
    
}



<div class="banner-container">
    <section class="banner">
        <video class="banner__video"
               autoplay
               muted
               loop
               playsinline
               poster="~/img/poster.jpg">
            <source src="~/video/FW_25_Low_Profile_Onsite_SEA_Masthead_SEA_DT_2880x1280_1_0d96f00db9 (1).mp4"
                    type="video/mp4" />
            Trình duyệt của bạn không hỗ trợ video.
        </video>

         
             <div class="banner__box"> 
                 <h2 class="banner__box-title">LOW PROFILE IN DESIGN.</h2> 
               <p class="banner__box-text">
                <span class="banner__box-line">
                    Khai phá nền văn hóa mới từ dòng chảy thể thao. Phong
                </span>
                <span class="banner__box-line">
                    cách cổ điển. Tinh thần tiên phong.
                </span>
            </p>
            <a asp-controller="Home" asp-action="SamBa" class="banner__button">
                    MUA NGAY
                </a> 
             </div>
    </section>
</div>



<div class="product-section">
    <div class="section-header">
        <h2>Adicolor</h2>
        <a asp-controller="Home" asp-action="SamBa">View All</a>
    </div>
    <div class="product-list">
        @if (Model != null && Model.SanPhams != null)
        {
            string anh = "";
            string ten = "Giay_Samba_Jane";
            @foreach (var sp in Model.SanPhams)
            {
                @if (anh.CompareTo(sp.HinhAnh) != 0 && ten.CompareTo(sp.TenSanPham) == 0)
                {
                    <div class="product-item">
                        <a class="product-card" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">
                            <img src="~/img/Giay/SamBa/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="Samba">
                        </a>
                        <div class="product-info">
                            <h5>@(sp.TenSanPham ?? "Không có tên")</h5>
                            <p class="price">@sp.Gia.ToString("N0") VND</p>
                            <a class="btn btn-primary add-to-cart-btn " asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">Chi Tiết Sản Phẩm</a>
                        </div>
                    </div>
                }
                anh = sp.HinhAnh;
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>
