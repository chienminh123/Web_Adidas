@model TheLoai

@{
    ViewData["Title"] = "adidas Vietnam Online";
}



<div class="banner-container">
    <section class="banner">
        <video class="banner__video"
               autoplay
               muted
               loop
               playsinline
               poster="~/img/poster.jpg">
            <source src="~/video/FW_25_Low_Profile_Onsite_SEA_Masthead_SEA_DT_2880x1280_1_0d96f00db9 (1).mp4"
                    type="video/mp4" />
            Trình duyệt của bạn không hỗ trợ video.
        </video>

         
             <div class="banner__box"> 
                 <h2 class="banner__box-title">LOW PROFILE IN DESIGN.</h2> 
               <p class="banner__box-text">
                <span class="banner__box-line">
                    Khai phá nền văn hóa mới từ dòng chảy thể thao. Phong
                </span>
                <span class="banner__box-line">
                    cách cổ điển. Tinh thần tiên phong.
                </span>
            </p> 
                <a href="#!" class="banner__button">
                    MUA NGAY
                </a> 
             </div>
    </section>
</div>



<div class="product-section">
    <div class="section-header">
        <h2>Adicolor</h2>
        <a href="#">View All</a>
    </div>
    <div class="product-list">
        @if (Model != null && Model.SanPhams != null)
        {
            string anh = "";
            string ten = "Giay_Samba_Jane";
            foreach (var sp in Model.SanPhams)
            {
                @if (anh.CompareTo(sp.HinhAnh) != 0 && ten.CompareTo(sp.TenSanPham) == 0)
                {
                    <div>
                        <a class="product-card" asp-controller="Home" asp-action="TrangSanPham">
                            <img src="~/img/Giay/SamBa/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="Samba">
                        </a>
                        <div class="product-info">
                            <h5>@(sp.TenSanPham ?? "Không có tên")</h5>

                            <p class="price">@sp.Gia.ToString("N0") VND</p>
                            <button type="button" class="btn btn-primary add-to-cart-btn" data-spid="@sp.MaSanPham">Thêm vào giỏ hàng</button>
                        </div>
                    </div>
                }


        
           
                @* anh = sp.HinhAnh; *@

            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $('.add-to-cart-btn').click(function () {
                var spId = $(this).data('spid');
                $.ajax({
                    url: '@Url.Action("AddItemToCart", "Cart")',
                    type: 'POST',
                    data: { spId: spId, soLuong: 1 }, // Gửi số lượng là 1
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Có thể cập nhật số lượng giỏ hàng ở đây nếu muốn
                        } else {
                            alert(response.message || "Có lỗi xảy ra.");
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            alert("Bạn cần đăng nhập để thêm vào giỏ hàng.");
                            window.location.href = '/Account/Login';
                        } else {
                            alert("Có lỗi xảy ra khi thêm vào giỏ hàng.");
                        }
                    }
                });
            });
        });
        
    </script>

}
