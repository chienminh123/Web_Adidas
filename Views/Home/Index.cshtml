<div class="banner-container">
    <section class="banner">
        <video class="banner__video"
               autoplay
               muted
               loop
               playsinline
               poster="~/img/poster.jpg">
            <source src="~/video/FW_25_Low_Profile_Onsite_SEA_Masthead_SEA_DT_2880x1280_1_0d96f00db9 (1).mp4"
                    type="video/mp4" />
            Trình duyệt của bạn không hỗ trợ video.
        </video>

         
             <div class="banner__box"> 
                 <h2 class="banner__box-title">LOW PROFILE IN DESIGN.</h2> 
               <p class="banner__box-text">
                <span class="banner__box-line">
                    Khai phá nền văn hóa mới từ dòng chảy thể thao. Phong
                </span>
                <span class="banner__box-line">
                    cách cổ điển. Tinh thần tiên phong.
                </span>
            </p> 
                <a href="#!" class="banner__button">
                    MUA NGAY
                </a> 
             </div>
    </section>
</div>

@{
    var products = Model?.SanPhams?.Take(4).ToList() ?? new List<SanPham>();
}

<div class="product-section">
    <div class="section-header">
        <h2>Adicolor</h2>
        <a href="#">View All</a>
    </div>
    <div class="product-list">
        @if (Model != null && Model.SanPhams != null)
        {
            foreach (var sp in Model.SanPhams.Take(4))
            {
                <a href="#" class="product-card">
                    <img src="~/img/Giay/Bo_suu_tap/Samba/Jane/Better Scarlet  Team Victory Red  Gum/@sp.HinhAnh" alt="@sp.TenSanPham" class="product-image" />
                    <div class="product-info">
                        <h5>@sp.TenSanPham</h5>
                        <p class="price">@String.Format("{0:N0}", sp.Gia) đ</p>
                        <button class="btn-add">Thêm vào giỏ hàng</button>
                    </div>
                </a>
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>





