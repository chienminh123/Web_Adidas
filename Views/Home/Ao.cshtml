@model TheLoai

@{
    ViewData["Title"] = "Ao";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />

    // Icon
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
          rel="stylesheet" />
   
}
<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__back">
        <span class="breadcrumb__icon">
            <i class="ri-arrow-left-line"></i>
        </span>
        <span class="breadcrumb__text">Trở lại</span>
    </a>
    <span class="breadcrumb__divider">/</span>
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a>
    <span class="breadcrumb__divider">/</span>
    <span class="breadcrumb__current">Quần</span>
</nav>
<form asp-action="Ao" asp-controller="Home" method="get">
    <div class="form-group">
        <label for="filter">Sắp xếp theo:</label>
        <select class="form-select" name="filter" id="filter" onchange="this.form.submit()">
            @if (ViewBag.SelectedFilter == "")
            {
                <option value="" selected>Bộ lọc</option>
            }
            else
            {
                <option value="">Bộ lọc</option>
            }
            @if (ViewBag.SelectedFilter == "1")
            {
                <option value="1" selected>Giá (Thấp -> Cao)</option>
            }
            else
            {
                <option value="1">Giá (Thấp -> Cao)</option>
            }
            @if (ViewBag.SelectedFilter == "2")
            {
                <option value="2" selected>Giá (Cao -> Thấp)</option>
            }
            else
            {
                <option value="2">Giá (Cao -> Thấp)</option>
            }
        </select>
    </div>
</form>

<div class="product__container">
    <p class="product__title">Áo</p>
    <div class="product-list">
        @if (Model != null && Model.SanPhams != null && Model.SanPhams.Any())
        {
            var uniqueProducts = Model.SanPhams.Where(sp => sp.MaTheLoai == 9).GroupBy(sp => sp.HinhAnh).Select(g => g.First());
            foreach (var sp in uniqueProducts)
            {
                <div class="product-item">
                    <a asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">
                        <img src="~/img/Ao/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="@sp.TenSanPham">
                    </a>
                    <div class="product-info">
                        <h5>@(sp.TenSanPham ?? "Không có tên")</h5>
                        <p class="price">@sp.Gia.ToString("N0") VND</p>
                        <a class="btn btn-primary add-to-cart-btn" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">Chi Tiết Sản Phẩm</a>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>
