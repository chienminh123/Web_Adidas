@model TheLoai

@{
    ViewData["Title"] = "Ao";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
   
}
<a asp-controller="Home" asp-action="Index">Home</a>
<p>@ViewData["Title"]</p>
<form asp-action="Ao" asp-controller="Home" method="get">
    <div class="form-group">
        <label for="filter">Sắp xếp theo:</label>
        <select class="form-select" name="filter" id="filter" onchange="this.form.submit()">
            @if (ViewBag.SelectedFilter == "")
            {
                <option value="" selected>Bộ lọc</option>
            }
            else
            {
                <option value="">Bộ lọc</option>
            }
            @if (ViewBag.SelectedFilter == "1")
            {
                <option value="1" selected>Giá (Thấp -> Cao)</option>
            }
            else
            {
                <option value="1">Giá (Thấp -> Cao)</option>
            }
            @if (ViewBag.SelectedFilter == "2")
            {
                <option value="2" selected>Giá (Cao -> Thấp)</option>
            }
            else
            {
                <option value="2">Giá (Cao -> Thấp)</option>
            }
        </select>
    </div>
</form>

<div>
    <p>Ao</p>
    <div>

        @if (Model != null && Model.SanPhams != null)
        {
            string anh = "";
           
            foreach (var sp in Model.SanPhams)
            {
                @if (anh.CompareTo(sp.HinhAnh) != 0 && sp.MaTheLoai== 9)
                {
                    <div>
                        <a class="product-card" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">
                            <img src="~/img/Ao/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="Ao">
                        </a>
                        <div class="product-info">
                            <h5>@(sp.TenSanPham ?? "Không có tên")</h5>

                            <p class="price">@sp.Gia.ToString("N0") VND</p>
                            <a class="btn btn-primary" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">Chi Tiết Sản Phẩm</a>
                        </div>
                    </div>
                }
                anh = sp.HinhAnh;
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>
