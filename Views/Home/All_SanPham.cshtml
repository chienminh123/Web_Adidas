<!-- Thanh chọn loại giày -->
<div id="shoe-nav" style="display: flex; gap: 20px; padding: 10px 0;">
    <a href="#samba-section">Samba</a>
    <a href="#gazelle-section">Gazelle</a>
    <a href="#adizero-section">Adizero</a>
    <a href="#superstar-section">Superstar</a>
    <a href="#sports-section">Sports</a>
</div>


<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__back">
        <span class="breadcrumb__icon">
            <i class="ri-arrow-left-line"></i>
        </span>
        <span class="breadcrumb__text">Trở lại</span>
    </a>
    <span class="breadcrumb__divider">/</span>
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a>
    <span class="breadcrumb__divider">/</span>
    <span class="breadcrumb__current">ALL</span>
</nav>


<form asp-action="All-SanPham" asp-controller="Home" method="get">
    <div class="form-group">
        <label for="filter">Sắp xếp theo:</label>
        <select class="form-select" name="filter" id="filter" onchange="this.form.submit()">
            @if (ViewBag.SelectedFilter == "")
            {
                <option value="" selected>Giá</option>
            }
            else
            {
                <option value="">Giá</option>
            }
            @if (ViewBag.SelectedFilter == "1")
            {
                <option value="1" selected>Thấp -> Cao</option>
            }
            else
            {
                <option value="1">Thấp -> Cao</option>
            }
            @if (ViewBag.SelectedFilter == "2")
            {
                <option value="2" selected>Cao -> Thấp</option>
            }
            else
            {
                <option value="2">Cao -> Thấp</option>
            }
        </select>
    </div>
</form>

<div class="product__container" id="samba-section">
    <p class="product__title" >Samba</p>
    <div class="product-list">
        @if (Model != null && Model.SanPhams != null)
        {
            string anh = "";
            foreach (var sp in Model.SanPhams)
            {
                @if (anh.CompareTo(sp.HinhAnh) != 0 && sp.MaTheLoai == 1)
                {
                    <div class="product-item">
                        <a class="product-card" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">
                            <img src="~/img/Giay/SamBa/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="Samba">
                        </a>
                        <div class="product-info">
                            <h5>@(sp.TenSanPham ?? "Không có tên")</h5>
                            <p class="price">@sp.Gia.ToString("N0") VND</p>
                            <a class="btn btn-primary add-to-cart-btn" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">Chi Tiết Sản Phẩm</a>
                        </div>
                    </div>
                }
                anh = sp.HinhAnh;
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>


