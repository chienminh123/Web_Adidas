@model TheLoai

@{
    ViewData["Title"] = "Superstar";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
    
}
<a asp-controller="Home" asp-action="Index">Home</a>
<p>@ViewData["Title"]</p>
<select class="form-select" aria-label="Default select example">
    <option selected>Bộ lọc </option>
    <option value="1">Giá (Thấp -> Cao)</option>
    <option value="2">Giá (Cao -> Thấp)</option>
</select>

<div>
    <p>dep</p>
    <div>

        @if (Model != null && Model.SanPhams != null)
        {
            string anh = "";
            
            foreach (var sp in Model.SanPhams)
            {
                @if (anh.CompareTo(sp.HinhAnh) != 0 && sp.MaTheLoai== 8)
                {
                    <div>
                        <a class="product-card" asp-controller="Home" asp-action="TrangSanPham">
                            <img src="~/img/Dep/@(sp.HinhAnh ?? "default.jpg")" class="card-img-top" alt="dep">
                        </a>
                        <div class="product-info">
                            <h5>@(sp.TenSanPham ?? "Không có tên")</h5>

                            <p class="price">@sp.Gia.ToString("N0") VND</p>
                            <a class="btn btn-primary" asp-controller="Home" asp-action="TrangSanPham" asp-route-hinhAnh="@sp.HinhAnh">Chi Tiết Sản Phẩm</a>
                        </div>
                    </div>
                }
                anh = sp.HinhAnh;
            }
        }
        else
        {
            <p>Không có sản phẩm để hiển thị.</p>
        }
    </div>
</div>
