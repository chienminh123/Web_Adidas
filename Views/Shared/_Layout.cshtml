    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Đảm bảo jQuery được tải trước khi chạy mã
        if (typeof jQuery === 'undefined') {
            console.error('jQuery is not loaded!');
        } else {
            $(document).ready(function () {
                // Cập nhật số lượng giỏ hàng
                function updateCartCount() {
                    fetch('/Cart/GetCartItemCount')
                        .then(response => {
                            if (!response.ok) {
                                if (response.status === 401) {
                                    window.location.href = '/Identity/Account/Login';
                                }
                                throw new Error('Network response was not ok');
                            }
                            return response.json();
                        })
                        .then(data => {
                            const cartCountSpan = $('.cart-count');
                            if (cartCountSpan.length) {
                                cartCountSpan.text(data.totalCartItems || 0);
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching cart count:', error);
                        });
                }

                // Hàm tìm kiếm sản phẩm
                function searchProducts() {
                const query = $('#searchInput').val().trim();
                const resultsDiv = $('#searchResults');

                if (query.length < 2) {
                    resultsDiv.hide().empty();
                    return;
                }

                console.log('Sending search request for:', query); // Debug
                $.ajax({
                    url: '@Url.Action("SearchProducts", "Home")',
                    type: 'GET',
                    data: { query: query },
                    dataType: 'json',
                    success: function (response) {
                        console.log('Search response:', response); // Debug
                        resultsDiv.empty();
                        if (response && Array.isArray(response) && response.length > 0) {
                            response.forEach(product => {
                                const hinhAnh = encodeURIComponent(product.HinhAnh || '');
                                const tenSanPham = (product.TenSanPham || 'Không có tên').replace(/"/g, '"');
                                const size = (product.Size || 'N/A').replace(/"/g, '"');
                                const gia = (product.Gia || 0).toLocaleString() + ' VND';

                                const itemHtml = `
                                    <a href="/Home/TrangSanPham?hinhAnh=${hinhAnh}" class="search-result-item">
                                        ${tenSanPham} (Size: ${size}, Giá: ${gia})
                                    </a>
                                `;
                                resultsDiv.append(itemHtml);
                            });
                            resultsDiv.show();
                        } else {
                            resultsDiv.append('<p>Không tìm thấy sản phẩm.</p>');
                            resultsDiv.show();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX Error:', error, xhr.responseText);
                        resultsDiv.html('<p>Có lỗi xảy ra khi tìm kiếm.</p>').show();
                    }
                });
            }

            updateCartCount();

            $('#searchInput').on('input', function () {
                searchProducts();
            });

            $('#searchButton').on('click', function () {
                searchProducts();
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.header__search').length) {
                    $('#searchResults').hide();
                }
            });
        });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>

</html>
