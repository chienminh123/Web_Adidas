
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  - Shop Sports & Originals | adidas VN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />

    
    @* <link rel="stylesheet" href="~/Web_Adidas.styles.css" asp-append-version="true" /> *@
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    @* Favicon *@
    <link rel="icon" type="image/png" href="~/favicons/favicon.ico">

    @* Font chữ *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Sora:wght@100..800&display=swap" rel="stylesheet">

</head>
<body>
    <div class="wrapper">
        <header class="header fixed">
            @* Logo *@
            <a href="/">
                <img class="header__logo" src="~/img/adidas.png" alt="Adidas Logo">
            </a>


            @* Nav *@
            <nav class="nav">
                <ul>
                    
                    <li class="nav__item nav__item--has-dropdown">
                        <a href="#!">
                            GIẦY
                            <span class="underline"></span>
                        </a>

                        <div class="shoe-dropdown">
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="SamBa">
                                    <div class="shoe-label">SAMBA</div>
                                    <img src="~/img/Giay_Samba_OG_trang_IF3814_01_standard_11zon.jpg" alt="Samba">
                                </a>
                            </div>
                            
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Gazelle">
                                    <div class="shoe-label">GAZELLE</div>
                                    <img src="~/img/Giay_Gazelle_Indoor_mau_xanh_la_JI2062_01_standard_11zon.jpg" alt="Gazelle">
                                </a>
                                
                            </div>
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Adizero">
                                    <div class="shoe-label">ADIZERO</div>
                                    <img src="~/img/Giay_Adizero_EVO_SL_DJen_JP7147_01_00_standard_11zon.jpg" alt="Adizero">
                                </a>
                                      
                            </div>
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Superstar">
                                    <div class="shoe-label">SUPERSTAR</div>
                                    <img src="~/img/Giay_Superstar_trang_JP9678_01_00_standard_11zon.jpg" alt="Superstar">
                                </a>
                                
                            </div>
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Sports">
                                    <div class="shoe-label">SPORT</div>
                                    <img src="~/img/Giay_san_co_nhan_tao_Predator_Pro_trang_JI1181_01_00_standard_hover_11zon.jpg" alt="Sport">
                                </a>
                                                           
                            </div>

                            <div class="shoe-view-all">
                                <a asp-controller="Home" asp-action="All_SanPham">Xem tất cả</a>
                            </div>
                        </div>
                        
                    </li>


                    <li class="nav__item nav__item--has-dropdown">
                       
                            <a href="#">
                                DÉP
                                <span class="underline"></span>
                            </a>
                        
                       
                        <div class="shoe-dropdown">
                            <div class="shoe-card" asp->
                                <a asp-controller="Home" asp-action="Dep">
                                    <div class="shoe-label">Dép </div>
                                    <img src="~/img/Adifom_Superstar_Mule_Slides_Tur1.png" alt="Dep">
                                </a>
                                
                            </div>
                            
                        </div>
                    </li>

                    <li class="nav__item nav__item--has-dropdown">
                        <a href="#">
                            QUẦN
                            <span class="underline"></span>
                        </a>
                        <div class="shoe-dropdown">
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Quan">
                                    <div class="shoe-label">QUẦN</div>
                                    <img src="~/img/Adicolor_Denim_3-Stripes_Track_P2.png" alt="Quan">
                                </a>
                                
                            </div>
                            
                        </div>
                    </li>

                    <li class="nav__item nav__item--has-dropdown">
                        <a href="#!">
                            ÁO
                            <span class="underline"></span>
                        </a>
                        <div class="shoe-dropdown">
                            <div class="shoe-card">
                                <a asp-controller="Home" asp-action="Ao">
                                    <div class="shoe-label">ÁO </div>
                                    <img src="~/img/Camo_Jacket_Green_JD5417_01_layd.png" alt="Ao">
                                </a>
                                
                            </div>
                            
                        </div>
                    </li>
                </ul>

            </nav>

            @* Action *@
            
            
            <div class="header__actions">
                <div class="header__search">
                    <input class="header__search-input" type="text" placeholder="Tìm kiếm sản phẩm..." id="searchInput">
                    <button class="header__search-button" id="searchButton">
                        <img src="~/img/search.png" alt="Search">
                    </button>
                    <div id="searchResults" class="search-results"></div>
                </div>
                <div class="header__icons">
                    <a class="header__icon-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" >
                        <img class="header__icon" src="~/img/user.png" alt="Hello @User.Identity?.Name!">
                    </a>
                    <a class="header__icon-link" asp-controller="Cart" asp-action="ViewCart">
                        <img class="header__icon" src="~/img/shopping-bag.png" alt="Cart">
                    </a>
                    <span class="cart-count">0</span>
                </div>
                <partial name="_LoginPartial" />
            </div>
         
        </header>
            
    
        <div class="main-content">    
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="footer">
            <div class="footer-container">
                <div class="footer-col footer-logo">
                    <img src="~/img/footer-01.jpg" alt="Adidas Logo">
                    <p>Adidas – Khơi nguồn cảm hứng thể thao và phong cách sống hiện đại.</p>
                </div>
                <div class="footer-col">
                    <h3>HỖ TRỢ</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="foot_TTTGiup">Trung tâm trợ giúp</a></li>
                        <li><a asp-controller="Home" asp-action="foot_HDmua">Hướng dẫn mua hàng</a></li>
                        <li><a asp-controller="Home" asp-action="foot_DoiTra">Chính sách đổi trả</a></li>
                        <li><a asp-controller="Home" asp-action="LienHe">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3>VỀ ADIDAS</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="CauChuyen">Câu chuyện thương hiệu</a></li>
                        <li><a asp-controller="Home" asp-action="TinTuc">Tin tức</a></li>
                        <li><a asp-controller="Home" asp-action="TuyenDung">Tuyển dụng</a></li>
                        <li><a asp-controller="Home" asp-action="CuaHang">Cửa hàng</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3>THEO DÕI CHÚNG TÔI</h3>
                    <div class="social-links">
                        <a href="https://www.facebook.com/adidasVN/?brand_redir=182162001806727#" target="_blank"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://www.instagram.com/adidas/" target="_blank"><i class="fab fa-instagram"></i></a>
                        <a href="https://www.youtube.com/c/adidas" target="_blank"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2025 Adidas Vietnam. Bản quyền thuộc về Adidas.
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const searchButton = document.getElementById('searchButton');
            const searchResults = document.getElementById('searchResults');
            const cartCountSpan = document.querySelector('.cart-count');

            // Hàm cập nhật số lượng giỏ hàng
            async function updateCartCount() {
                try {
                    const response = await fetch('/Cart/GetCartItemCount');
                    if (!response.ok) {
                        if (response.status === 401) {
                            console.warn('Chưa đăng nhập, chuyển hướng đến trang đăng nhập.');
                            window.location.href = '/Identity/Account/Login';
                            return;
                        }
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    const data = await response.json();
                    if (cartCountSpan) {
                        cartCountSpan.textContent = data.totalCartItems || 0;
                        console.log(`Cập nhật giỏ hàng: ${data.totalCartItems} sản phẩm`);
                    }
                } catch (error) {
                    console.error('Lỗi khi cập nhật giỏ hàng:', error);
                    if (cartCountSpan) {
                        cartCountSpan.textContent = '0';
                    }
                }
            }


            // Hàm tìm kiếm và hiển thị kết quả
            async function fetchSearchResults(query) {
                if (!query.trim()) {
                    searchResults.style.display = 'none';
                    searchResults.innerHTML = '';
                    return;
                }

                try {
                    console.log(`Đang tìm kiếm với từ khóa: "${query}"`);
                    const response = await fetch(`/Home/SearchProducts?query=${encodeURIComponent(query)}`);
                    if (!response.ok) {
                        let message = 'Lỗi khi tải kết quả tìm kiếm.';
                        if (response.status === 400) {
                            message = 'Từ khóa tìm kiếm không hợp lệ.';
                        } else if (response.status === 500) {
                            message = 'Lỗi máy chủ, vui lòng thử lại sau.';
                        }
                        throw new Error(message);
                    }

                    const data = await response.json();
                    console.log('Phản hồi từ server:', data);

                   

                    data.results.forEach(product => {
                        
                        if (!product || typeof product !== 'object') {
                            console.warn('Sản phẩm không hợp lệ:', product);
                            return;
                        }

                        let imagePath = '/img/'; 
                    switch (product.maTheLoai) { // switch case của JavaScript
                        case 1:
                            imagePath += 'Giay/Samba/';
                            break;
                        case 2:
                            imagePath += 'Giay/Gazelle/';
                            break;
                        case 3:
                            imagePath += 'Giay/Adizero/'; 
                            break;
                        case 4:
                            imagePath += 'Giay/Superstar/';
                            break;
                        case 5:
                            imagePath += 'Giay/The_Thao/';
                            break;
                        case 8:
                            imagePath += 'Dep/';
                            break;
                        case 9:
                            imagePath += 'Ao/';
                            break;
                        case 13:
                            imagePath += 'Quan/';
                            break;
                        default:
                            console.log("Sản phẩm chưa có mã sản phẩm !")
                            break;
                    }
                        const resultItem = document.createElement('div');
                        resultItem.className = 'search-result-item';
                        resultItem.innerHTML = `
                        
                            <img src="${imagePath}${product.hinhAnh ?? 'default.jpg'}" alt="${product.tenSanPham || 'Sản phẩm'}">
                            <div>
                                <strong>${product.tenSanPham ?? 'Không có tên'}</strong><br>
                                <span>Giá: ${(product.gia ?? 0).toLocaleString('vi-VN')} VNĐ</span><br>
                                <span>Size: ${product.size ?? 'N/A'}</span>
                                
                            </div>
                        `;
                        resultItem.addEventListener('click', () => {
                            console.log(`Chuyển hướng đến sản phẩm: ${product.tenSanPham ?? 'Không có tên'}`);
                            window.location.href = `/Home/TrangSanPham?hinhAnh=${encodeURIComponent(product.hinhAnh || '')}`;
                        });
                        searchResults.appendChild(resultItem);
                    });
                    searchResults.style.display = 'block';
                } catch (error) {
                    console.error('Lỗi khi tìm kiếm:', error);
                    searchResults.innerHTML = `<div class="no-results">${error.message}</div>`;
                    searchResults.style.display = 'block';
                }
            }

            // Gọi cập nhật giỏ hàng
            updateCartCount();

            // Sự kiện khi nhấn nút tìm kiếm
            searchButton.addEventListener('click', () => {
                const query = searchInput.value;
                fetchSearchResults(query);
            });

            // Sự kiện khi nhập liệu (debounce)
            let debounceTimer;
            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    const query = searchInput.value;
                    fetchSearchResults(query);
                }, 300);
            });

            // Sự kiện khi nhấn phím Enter
            searchInput.addEventListener('keypress', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    const query = searchInput.value;
                    fetchSearchResults(query);
                }
            });

            // Ẩn kết quả khi nhấp ra ngoài
            document.addEventListener('click', (event) => {
                if (!searchResults.contains(event.target) && !searchInput.contains(event.target) && !searchButton.contains(event.target)) {
                    searchResults.style.display = 'none';
                }
            });
        });
          
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>

</html>
