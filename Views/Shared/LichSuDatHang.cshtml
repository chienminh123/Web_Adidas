@model DonHang
@using System.Security.Claims
@{
    ViewData["Title"] = "Lịch sử mua hàng ";
    // Icon
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
          rel="stylesheet" />
}
<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__back">
        <span class="breadcrumb__icon">
            <i class="ri-arrow-left-line"></i>
        </span>
        <span class="breadcrumb__text">BACK</span>
    </a>
    <span class="breadcrumb__divider">/</span>
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Home</a>
    <span class="breadcrumb__divider">/</span>
    <span class="breadcrumb__current">Lịch sử đặt hàng</span>
</nav>
<p>@ViewData["Title"]</p>

@if (Model != null && Model.ChiTietDonHangs != null)
{
    
    int i=0;
    <div>
        @foreach (var item in Model.ChiTietDonHangs)
        {
        
            @if (item.DonHang != null && item.MaDonHang!=i) 
            {
                <div>

                    <h1>Mã đơn hàng: @item.MaDonHang</h1>
                    <h2>Ngày đặt hàng: @item.DonHang.NgayTaoDonHang</h2>
                    <h2>Phương thức thanh toán: @item.DonHang.PTThanhToan</h2>
                    <a href="@Url.Action("ChiTietDonHang", "Cart", new { maDonHang =item.MaDonHang })">Xem chi tiết</a>

                    @if (item.DonHang.MaTrangThaiDonHang == 1)
                    {
                        <button type="button"
                                class="btn btn-danger remove-item-btn ms-3"
                                data-spid="@item.MaDonHang">
                            Hủy
                        </button>
                    }
                    else if (item.DonHang.MaTrangThaiDonHang == 4 )
                    {
                        
                            <a asp-controller="Cart" asp-action="KhieuNai" asp-route-maDonHang="@item.MaDonHang"> Khiếu nại </a>
                        
                    }
                    
                    
                </div>
            }
            i = item.MaDonHang;
        }
    </div>
}
else
{
    <div class="alert alert-info">Lịch sử mua hàng của bạn đang trống.</div>
    
}
@section Scripts{
    <script>
        $(document).ready(function () {
        // Xử lý nút "Hủy"
                $('.remove-item-btn').click(function () {
                    var maDonHang = $(this).data('spid'); // Lấy maDonHang từ data-spid

                    if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                        $.ajax({
                            url: '@Url.Action("CancelOrder", "Cart")',
                            type: 'POST',
                            data: { maDonHang: maDonHang },
                            success: function (response) {
                                if (response.success) {
                                    alert(response.message);
                                    location.reload(); 
                                } else {
                                    alert(response.message || 'Không thể hủy đơn hàng.');
                                }
                            },
                            error: function (xhr) {
                                var errorMessage = xhr.responseJSON && xhr.responseJSON.message
                                    ? xhr.responseJSON.message
                                    : 'Có lỗi xảy ra khi hủy đơn hàng.';
                                alert(errorMessage);
                            }
                        });
                    }
                });
            });
            
        
    </script>   
            
    
}