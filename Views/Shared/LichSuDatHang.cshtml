@model DonHang
@using System.Security.Claims
@{
    ViewData["Title"] = "Lịch sử mua hàng ";
    @* // Icon *@
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
          rel="stylesheet" />

}

<nav class="breadcrumb">
    <a href="@Url.Action("ViewCart", "Cart")" class="breadcrumb__back">
        <span class="breadcrumb__icon">
            <i class="ri-arrow-left-line"></i>
        </span>
        <span class="breadcrumb__text">Trở lại</span>
    </a>

    <span class="breadcrumb__divider">/</span>
    <a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a>
</nav>

<h2 class="order-history__title">@ViewData["Title"]</h2>

@if (Model != null && Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
{
    int i = 0;
    <div class="order-history__list">
        @foreach (var item in Model.ChiTietDonHangs)
        {
            @if (item.DonHang != null && item.MaDonHang != i)
            {
                <div class="order-card">
                    <div class="order-card__info">
                        <div class="order-card__row">
                            <span class="order-card__label">Mã đơn hàng:</span>
                            <span class="order-card__value">@item.MaDonHang</span>
                        </div>
                        <div class="order-card__row">
                            <span class="order-card__label">Ngày đặt hàng:</span>
                            <span class="order-card__value">@item.DonHang.NgayTaoDonHang</span>
                        </div>
                        <div class="order-card__row">
                            <span class="order-card__label">Thanh toán:</span>
                            <span class="order-card__value">@item.DonHang.PTThanhToan</span>
                        </div>
                        @* <div class="order-card__row"> *@
                        @*     <span class="order-card__label">Trạng thái đơn hàng:</span> *@
                        @*     <span class="order-card__value">@item.DonHang.TenTrangThaiDonHang</span> *@
                        @* </div> *@
                    </div>

                    <div class="order-card__actions">
                        <a href="@Url.Action("ChiTietDonHang", "Cart", new { maDonHang = item.MaDonHang })" class="order-card__link">Xem chi tiết</a>

                        @if (item.DonHang.MaTrangThaiDonHang == 1)
                        {
                            <button type="button"
                                    class="order-card__button order-card__button--cancel remove-item-btn"
                                    data-spid="@item.MaDonHang">
                                Hủy
                            </button>
                        }
                        else if (item.DonHang.MaTrangThaiDonHang == 4)
                        {
                            <a asp-controller="Cart" asp-action="KhieuNai" asp-route-maDonHang="@item.MaDonHang" class="order-card__link order-card__link--complain ">Khiếu nại</a>
                        }
                    </div>
                </div>
            }
            i = item.MaDonHang;
        }
    </div>
}
else
{
    <div class="order-history__empty">Lịch sử mua hàng của bạn đang trống.</div>
}
@section Scripts{
    <script>
        $(document).ready(function () {
        // Xử lý nút "Hủy"
                $('.remove-item-btn').click(function () {
                    var maDonHang = $(this).data('spid'); // Lấy maDonHang từ data-spid

                    if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                        $.ajax({
                            url: '@Url.Action("CancelOrder", "Cart")',
                            type: 'POST',
                            data: { maDonHang: maDonHang },
                            success: function (response) {
                                if (response.success) {
                                    alert(response.message);
                                    location.reload(); // Tải lại trang để cập nhật danh sách đơn hàng
                                } else {
                                    alert(response.message || 'Không thể hủy đơn hàng.');
                                }
                            },
                            error: function (xhr) {
                                var errorMessage = xhr.responseJSON && xhr.responseJSON.message
                                    ? xhr.responseJSON.message
                                    : 'Có lỗi xảy ra khi hủy đơn hàng.';
                                alert(errorMessage);
                            }
                        });
                    }
                });
            });
          
        
    </script>   
            
    
}