@using System.Security.Claims
@model GioHang
@{
    ViewData["Title"] = "ViewCart";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
}
<h1>Giỏ hàng  </h1>

@if (Model != null && Model.ChiTietGioHangs != null && Model.ChiTietGioHangs.Any())
{

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    <div class="cart-list">

        @foreach (var item in Model.ChiTietGioHangs)
        {
            
            
                <div class="cart-item d-flex align-items-center border-bottom py-3 mb-2">
                    <div class="cart-img me-3">
                        <img src="~/img/Giay/Bo_suu_tap/Samba/Jane/Better Scarlet  Team Victory Red  Gum/@(item.SanPham.HinhAnh ?? "default.jpg")"
                             alt="@item.SanPham.TenSanPham"
                             style="width: 96px; height: 96px; object-fit: cover;" />
                    </div>
                    <div class="flex-grow-1">
                        <h5>@item.SanPham.TenSanPham</h5>
                        <div>Size : @item.SanPham.Size </div>
                        <div>Giá: @item.SanPham.Gia.ToString("N0") VND</div>
                        <div>Số lượng: @item.SoLuong</div>
                        <div class="fw-bold">Tổng: @item.DonGia.ToString("N0") VND</div>
                    </div>
                    <button type="button"
                            class="btn btn-danger remove-item-btn ms-3"
                            data-spid="@item.MaSanPham">
                        Xóa
                    </button>
                </div>
            
            
            
        }
    </div>
}
else
{
    <div class="alert alert-info">Giỏ hàng của bạn đang trống.</div>
}


@section Scripts {
    <script>
        $(document).ready(function () {
            $('.remove-item-btn').click(function () {
                var spId = $(this).data('spid');
                var $itemRow = $(this).closest('.flex.items-center');
                $.ajax({
                    url: '@Url.Action("RemoveItemFromCart", "Cart")',
                    type: 'POST',
                    data: { spId: spId },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Xóa phần tử sản phẩm khỏi giao diện
                            $itemRow.remove();
                            location.reload();
                        } else {
                            alert(response.message || "Có lỗi xảy ra.");
                        }
                    }
                    
                });
            });
        });
    </script>
}

