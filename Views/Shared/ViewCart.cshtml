@using System.Security.Claims
@model GioHang
@{
    ViewData["Title"] = "ViewCart";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
    // @section Scripts {
        
    //     <script src="~/js/site.js" asp-append-version="true"></script>
    // }
}
<h1>Giỏ hàng  </h1>
<a asp-controller="Home" asp-action="LichSuDatHang" >Lịch sử mua hàng </a>
@if (Model != null && Model.ChiTietGioHangs != null && Model.ChiTietGioHangs.Any())
{

   
    <div class="cart-list">

        @foreach (var item in Model.ChiTietGioHangs)
        {
            int chon = item.SanPham.MaTheLoai;

                <div class="cart-item d-flex align-items-center border-bottom py-3 mb-2">
                    <div class="cart-img me-3">
                    @switch (chon)
                    {
                        case 1:
                            {
                                <img src="~/img/Giay/Samba/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 2:
                            {
                                <img src="~/img/Giay/Gazelle/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                     style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 3:
                            {
                                <img src="~/img/Giay/Adizero/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                     style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 4:
                            {
                                <img src="~/img/Giay/Superstar/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 5 or 6 or 7:
                            {
                                <img src="~/img/Giay/The_Thao/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                     style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        
                        case 8:
                            {
                                <img src="~/img/Dep/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 9:
                            {
                                <img src="~/img/Ao/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                     style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                        case 13:
                            {
                                <img src="~/img/Quan/@(item.SanPham.HinhAnh ?? "default.jpg")"
                                     alt="@item.SanPham.TenSanPham"
                                     style="width: 96px; height: 96px; object-fit: cover;" />
                                break;
                            }
                    }
                    
                    
                             
                    </div>
                    <div class="flex-grow-1">
                        <h5>@item.SanPham.TenSanPham</h5>
                        <div>@item.SanPham.Size</div>
                        <div>Giá: @item.SanPham.Gia.ToString("N0") VND</div>
                    <td>
                        <button class="btn-qty" data-action="decrease" data-id="@item.MaSanPham">-</button>
                        <span class="cart-qty" id="qty-@item.MaSanPham">@item.SoLuong</span>
                        <button class="btn-qty" data-id="@item.MaSanPham" data-action="increase">+</button>
                    </td>
                        <div class="fw-bold">Tổng: @item.DonGia.ToString("N0") VND</div>
                    </div>
                    <button type="button"
                            class="btn btn-danger remove-item-btn ms-3"
                            data-spid="@item.MaSanPham">
                        Xóa
                    </button>
                </div>
            
            
            
        }
    </div>
}
else
{
    <div class="alert alert-info">Giỏ hàng của bạn đang trống.</div>
}
<form asp-action="ThanhToan" asp-controller="Cart">
    <button type="submit">Thanh toán</button>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.remove-item-btn').click(function () {
                var spId = $(this).data('spid');
                var $itemRow = $(this).closest('.flex.items-center');
                $.ajax({
                    url: '@Url.Action("RemoveItemFromCart", "Cart")',
                    type: 'POST',
                    data: { spId: spId },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Xóa phần tử sản phẩm khỏi giao diện
                            $itemRow.remove();
                            location.reload();
                        } else {
                            alert(response.message || "Có lỗi xảy ra.");
                        }
                    }
                    
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('.btn-qty').click(function () {
                var spId = $(this).data('id');
                var action = $(this).data('action');
                var url = '';
                if (action === 'increase') {
                    url = '/Cart/AddItemToCart';
                } else if (action === 'decrease') {
                    url = '/Cart/DecreaseItemFromCart';
                }
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { spId: spId },
                    success: function (response) {
                        if (response.success) {
                            // Cập nhật số lượng trên giao diện
                            if (action == 'increase') {
                                var qty = parseInt($('#qty-' + spId).text()) + 1;
                                $('#qty-' + spId).text(qty);
                                location.reload();
                            } else if (action == 'decrease') {
                                var qty = parseInt($('#qty-' + spId).text()) - 1;
                                if (qty > 0) {
                                    $('#qty-' + spId).text(qty);
                                    
                                    location.reload();
                                } else {
                                    // Nếu số lượng = 0 thì có thể xóa dòng sản phẩm khỏi bảng
                                    location.reload();
                                }
                            }
                        } else {
                            alert(response.message || "Có lỗi xảy ra.");
                        }
                    },
                    error: function () {
                        alert("Có lỗi xảy ra khi cập nhật số lượng.");
                    }
                });
            });
        });
    </script>
    
}

