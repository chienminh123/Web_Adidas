@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="profile__title">@ViewData["Title"]</h3>

<div class="profile">
    <div class="profile__container">
        <p class="profile__text">
            Your account contains personal data that you have given us. This page allows you to download or delete that data.
        </p>
        <p class="profile__text profile__warning">
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>

        <div class="form__group form__group--actions">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="form__button" type="submit">Download</button>
            </form>

            <a id="delete" asp-page="DeletePersonalData" class="form__button form__button--danger">Delete</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

