@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="profile__title">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="profile">
    <div class="profile__container">
        <form id="change-password-form" method="post" class="profile__form">
            <div asp-validation-summary="ModelOnly" class="profile__error-summary text-danger"></div>

            <div class="form__group">
                <input asp-for="Input.OldPassword" class="form__input" autocomplete="current-password" aria-required="true" />
                <label asp-for="Input.OldPassword" class="form__label"></label>
                <span asp-validation-for="Input.OldPassword" class="form__error text-danger"></span>
            </div>

            <div class="form__group">
                <input asp-for="Input.NewPassword" class="form__input" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.NewPassword" class="form__label"></label>
                <span asp-validation-for="Input.NewPassword" class="form__error text-danger"></span>
            </div>

            <div class="form__group">
                <input asp-for="Input.ConfirmPassword" class="form__input" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.ConfirmPassword" class="form__label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="form__error text-danger"></span>
            </div>

            <button type="submit" class="form__button">Update password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

