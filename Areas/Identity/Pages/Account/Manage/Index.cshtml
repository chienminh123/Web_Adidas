@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="profile__title">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="profile">
    <div class="profile__container">
        <form id="profile-form" method="post" class="profile__form">
            <div asp-validation-summary="ModelOnly" class="profile__error-summary text-danger"></div>

            <div class="form__group">
                <input asp-for="Username" class="form__input" disabled />
                <label asp-for="Username" class="form__label"></label>
            </div>

            <div class="form__group">
                <input asp-for="Input.PhoneNumber" class="form__input" />
                <label asp-for="Input.PhoneNumber" class="form__label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="form__error text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="form__button">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

