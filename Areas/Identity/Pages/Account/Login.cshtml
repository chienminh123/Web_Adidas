@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="page-wrapper">
    <div class="login-container">
        <div class="login-box">
            <h2>@ViewData["Title"]</h2>
            <section>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Nhập email của bạn" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-remember">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-label">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <div>
                        <button id="login-submit" type="submit" class="btn-login">Đăng nhập</button>
                    </div>

                    <div class="links">
                        <p><a id="forgot-password" asp-page="./ForgotPassword">Quên mật khẩu?</a></p>
                        <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng kí tài khoản mới</a></p>
                        <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Gửi lại xác nhận email</a></p>
                    </div>
                </form>
            </section>
        </div>

        <div class="login-image">
            <img src="~/img/login-02.jpg" alt="Adidas" />
        </div>
    </div>
</div>

    

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
